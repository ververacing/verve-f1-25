# C-1 start calibration (docs/verve_c1_prereg.md): 20 starts per launch, start-only. The menu part is
# v1_austria_4races.plan unchanged (spectator garage start, Custom grid with the player last, difficulty 100,
# weather LOCKED, Austria) up to and including race 1's `pad a 700`, the ai_drives_player lines and the race-1
# `@sessioncheck 100 17 0`. Then `@startwait 20` (race 1's start) and 19 x (`@restart`, `@startwait 20`): race 1 +
# 19 restarts = 20 starts, no finish. Run by tools/v1_run.ps1 -Make c1 (one launch per call, that launch's
# verve.c1-l<LL> add-on switched on with -Addon); checked by tools/c1_check.py.
wait screen=splash 180
pad ls 15000
pad ls
pad ls 2000
pad ls
home
@sleep 3
@raw {"seq":0,"cmd":"route","args":{"route":"f1_world"},"timeout_ms":60000}
@sleep 5
@expect fe_f1_world
@raw {"seq":0,"cmd":"route","args":{"route":"play"},"timeout_ms":60000}
@sleep 6
@expect f1_world_activity_container
# the Grand Prix card
pad a 250
@sleep 6
# the season: one right is F1 2025
pad right 250
@sleep 3
pad a 250
@sleep 6
@expect solo_container
# round 1's track: ten right from Australia is Austria (Red Bull Ring, UDP track id 17; seen on screen in the
# H-dry discovery, 26566308). V-1 runs at Austria by the track rule (net held passes per race-minute 3.8x Hungary).
pad right 200
pad right 200
pad right 200
pad right 200
pad right 200
pad right 200
pad right 200
pad right 200
pad right 200
pad right 200
@sleep 2
pad a 250
@sleep 7
@expect solo_container
# team: four right from McLaren is Aston Martin. Then the driver: Stroll is the default
pad right 200
pad right 200
pad right 200
pad right 200
@sleep 2
pad a 250
@sleep 7
@expect solo_container
pad a 250
@sleep 7
@expect settings_container
# Difficulty 100: from Start Event, right then down is the Difficulty tile. Holding right reaches the cap of 110 from
# any start, and ten presses left from there is exactly 100. Then back to the hub (Difficulty selected).
pad right 250
@sleep 2
pad down 250
@sleep 2
pad a 250
@sleep 4
pad right 6000
@sleep 2
pad left 200
pad left 200
pad left 200
pad left 200
pad left 200
pad left 200
pad left 200
pad left 200
pad left 200
pad left 200
@sleep 2
pad b 250
@sleep 4
# #131 workaround grid (msyeett.starting-grid 0.1.4, enabled in verve-test): down from Difficulty is Weekend Structure
# (Qualifying Format Off, Starting Grid Realistic). Five down is Grid Editor; opening it makes Starting Grid Custom.
# The player (Stroll) starts at P1 with the cursor on him; X moves him down one, 19 presses put him 20th (last)
# and every AI car moves up one in the game's order. B asks Confirm Changes (A), B again is the hub on Weekend
# Structure, and up is Difficulty again for the weather steps. Found by runs/2026-11-16-H-grid-discovery.
pad down 250
@sleep 2
pad a 250
@sleep 4
pad down 200
@sleep 1
pad down 200
@sleep 1
pad down 200
@sleep 1
pad down 200
@sleep 1
pad down 200
@sleep 1
@sleep 1
pad a 250
@sleep 4
pad x 250
@sleep 1
pad x 250
@sleep 1
pad x 250
@sleep 1
pad x 250
@sleep 1
pad x 250
@sleep 1
pad x 250
@sleep 1
pad x 250
@sleep 1
pad x 250
@sleep 1
pad x 250
@sleep 1
pad x 250
@sleep 1
pad x 250
@sleep 1
pad x 250
@sleep 1
pad x 250
@sleep 1
pad x 250
@sleep 1
pad x 250
@sleep 1
pad x 250
@sleep 1
pad x 250
@sleep 1
pad x 250
@sleep 1
pad x 250
@sleep 1
@sleep 2
pad b 250
@sleep 4
# Confirm Changes
pad a 250
@sleep 4
pad b 250
@sleep 4
pad up 250
@sleep 2
# #118 weather lock: up then right from Difficulty is the Weather and Time of Day tile. Its first row, Quick Weather,
# starts at Dynamic (random weather); one press right is Clear (Dry), which holds for the whole weekend.
pad up 250
@sleep 2
pad right 250
@sleep 2
pad a 250
@sleep 4
pad right 250
@sleep 3
# back to the hub (Weather selected), then two left is Start Event
pad b 250
@sleep 4
pad left 250
@sleep 2
pad left 250
@sleep 3
# back on the hub, Start Event selected
pad a 250
@sleep 8
# one press inside the grid rundown, before lights out (about 108 s into the session), for #65
@sleep 125
# only press inside the rundown: on the grid, this press would fire Start Race. All 3 test runs read this state
@expect \|hud\|#fe9b028c\|
pad a 250
@sleep 4
status
wait screen=garage_monitor_container 300
@sleep 8
@expect garage_monitor_container
pad a 700
@sleep 2
@raw {"seq":0,"cmd":"ai_drives_player","args":{"on":true},"timeout_ms":30000}
@sleep 2
@raw {"seq":0,"cmd":"ai_drives_player","args":{"on":true},"timeout_ms":30000}
# V-1 guard (supervisor, 2026-11-17): at race 1's lights out the Session packet must read AI difficulty 100, track 17
# (Austria) and weather 0, else the launch ends at once (invalid) and tools/v1_run.ps1 reruns it once. Race 1 only:
# the restarts keep the settings.
@sessioncheck 100 17 0
# C-1 start-only (supervisor's ruling on the 1-lap gap): no race finishes. Wait for this race's lights out (LGOT),
# then until the capture is LGOT + 20 s in (the CUTOFF: D1's slowest T1 crossing was 9.11-9.34 s after LGOT), then
# restart. Each restart is a new UDP session uid with its own LGOT and the same grid; @startwait excludes the uids
# already done (tools/sandbox_shell.ps1, tools/udp_finish_watch.py --start-only).
# start 1 (race 1)
@startwait 20
# start 2: restart from the pause menu (same grid), then the start-only wait
@restart
@startwait 20
# start 3: restart from the pause menu (same grid), then the start-only wait
@restart
@startwait 20
# start 4: restart from the pause menu (same grid), then the start-only wait
@restart
@startwait 20
# start 5: restart from the pause menu (same grid), then the start-only wait
@restart
@startwait 20
# start 6: restart from the pause menu (same grid), then the start-only wait
@restart
@startwait 20
# start 7: restart from the pause menu (same grid), then the start-only wait
@restart
@startwait 20
# start 8: restart from the pause menu (same grid), then the start-only wait
@restart
@startwait 20
# start 9: restart from the pause menu (same grid), then the start-only wait
@restart
@startwait 20
# start 10: restart from the pause menu (same grid), then the start-only wait
@restart
@startwait 20
# start 11: restart from the pause menu (same grid), then the start-only wait
@restart
@startwait 20
# start 12: restart from the pause menu (same grid), then the start-only wait
@restart
@startwait 20
# start 13: restart from the pause menu (same grid), then the start-only wait
@restart
@startwait 20
# start 14: restart from the pause menu (same grid), then the start-only wait
@restart
@startwait 20
# start 15: restart from the pause menu (same grid), then the start-only wait
@restart
@startwait 20
# start 16: restart from the pause menu (same grid), then the start-only wait
@restart
@startwait 20
# start 17: restart from the pause menu (same grid), then the start-only wait
@restart
@startwait 20
# start 18: restart from the pause menu (same grid), then the start-only wait
@restart
@startwait 20
# start 19: restart from the pause menu (same grid), then the start-only wait
@restart
@startwait 20
# start 20: restart from the pause menu (same grid), then the start-only wait
@restart
@startwait 20
status
